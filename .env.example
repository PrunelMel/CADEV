# Copier ce fichier en .env puis changer au moins BETTER_AUTH_SECRET.

# PostgreSQL (docker-compose expose le port 5433 sur la machine)
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
DATABASE_URL=postgres://platform:platform@localhost:5433/platform

# API
PORT=4000
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:4000
# 32 caractères minimum. Exemple de génération : openssl rand -hex 32
BETTER_AUTH_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum

# Stockage MinIO (compatible S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=platform
S3_SECRET_KEY=platform-secret
S3_BUCKET=platform
MAX_UPLOAD_MB=500
