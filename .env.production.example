# Production : copier en .env sur le serveur, à côté de docker-compose.prod.yml, puis tout remplir.
# Générer chaque secret avec : openssl rand -hex 32

# Domaine du site (enregistrement DNS A vers l'IP du serveur)
DOMAIN=7iven8n.online

POSTGRES_USER=platform
POSTGRES_PASSWORD=changer-moi
POSTGRES_DB=platform

BETTER_AUTH_SECRET=changer-moi-32-caracteres-minimum

S3_ACCESS_KEY=platform
S3_SECRET_KEY=changer-moi
S3_BUCKET=platform
MAX_UPLOAD_MB=500

RESEND_API_KEY=re_...
MAIL_FROM=Plateforme IA appliquée <noreply@7iven8n.online>
